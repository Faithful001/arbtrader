# ============================================================
# ArbTrader Server — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/arbtrader
# For Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# eBay API (https://developer.ebay.com)
EBAY_APP_ID=your-ebay-app-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_USER_TOKEN=your-ebay-user-token

# eBay OAuth
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# FX API (https://exchangerate.host — free tier available)
FX_API_KEY=your-fx-api-key
FX_BASE_CURRENCY=GBP

# Arbitrage Engine Settings
ARBITRAGE_MIN_NET_PROFIT_GBP=5.0
ARBITRAGE_MIN_CONFIDENCE_SCORE=0.6
ARBITRAGE_RECALC_INTERVAL_MINUTES=60
PRICE_INGESTION_INTERVAL_MINUTES=120

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Mock Mode (set to true to use mock data instead of live APIs)
USE_MOCK_DATA=true
